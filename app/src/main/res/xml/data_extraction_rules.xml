<?xml version="1.0" encoding="utf-8" ?>
<data-extraction-rules>
    <!-- auris.db contains local library entities; auth credentials are held in Supabase secure storage, not Room -->
    <cloud-backup>
        <include domain="database" path="auris.db" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="auris.db" />
    </device-transfer>
</data-extraction-rules>
